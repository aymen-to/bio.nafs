<script>
// ─── PARTICLES ───
(function(){
  const wrap=document.getElementById('particles');
  for(let i=0;i<18;i++){
    const p=document.createElement('div');
    p.className='particle';
    p.style.cssText=`left:${Math.random()*100}%;width:${Math.random()*4+2}px;height:${Math.random()*4+2}px;animation-duration:${Math.random()*12+8}s;animation-delay:${Math.random()*8}s;opacity:${Math.random()*.4+.2}`;
    wrap.appendChild(p);
  }
})();

// ─── SCROLL REVEAL ───
const ro=new IntersectionObserver((entries)=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');ro.unobserve(e.target)}});
},{threshold:.12});
document.querySelectorAll('.reveal,.reveal-left,.reveal-right').forEach(el=>ro.observe(el));

// ─── WILAYA DATA ───
const PRICE=1200;
const WILAYAS=[
  {n:"أدرار",h:1300,o:800,d:"J/J+5"},
  {n:"الشلف",h:750,o:450,d:"J/J+1"},
  {n:"الأغواط",h:900,o:450,d:"J/J+1"},
  {n:"أم البواقي",h:700,o:450,d:"J/J+1"},
  {n:"باتنة",h:700,o:450,d:"J/J+1"},
  {n:"بجاية",h:750,o:450,d:"J/J+1"},
  {n:"بسكرة",h:900,o:450,d:"J/J+1"},
  {n:"بشار",h:1000,o:600,d:"J/J+3"},
  {n:"البليدة",h:700,o:450,d:"J/J+1"},
  {n:"البويرة",h:750,o:450,d:"J/J+1"},
  {n:"تمنراست",h:1500,o:750,d:"J/J+5"},
  {n:"تبسة",h:800,o:450,d:"J/J+1"},
  {n:"تلمسان",h:850,o:450,d:"J/J+1"},
  {n:"تيارت",h:850,o:450,d:"J/J+1"},
  {n:"تيزي وزو",h:750,o:450,d:"J/J+1"},
  {n:"الجزائر",h:600,o:450,d:"J/J+1"},
  {n:"الجلفة",h:900,o:500,d:"J/J+1"},
  {n:"جيجل",h:700,o:450,d:"J/J+1"},
  {n:"سطيف",h:450,o:300,d:"J/J+1"},
  {n:"سعيدة",h:800,o:450,d:"J/J+1"},
  {n:"سكيكدة",h:750,o:450,d:"J/J+1"},
  {n:"سيدي بلعباس",h:850,o:450,d:"J/J+1"},
  {n:"عنابة",h:750,o:450,d:"J/J+1"},
  {n:"قالمة",h:700,o:450,d:"J/J+1"},
  {n:"قسنطينة",h:700,o:450,d:"J/J+1"},
  {n:"المدية",h:750,o:450,d:"J/J+1"},
  {n:"مستغانم",h:850,o:450,d:"J/J+1"},
  {n:"المسيلة",h:800,o:450,d:"J/J+1"},
];

const sel=document.getElementById('f-wilaya');
WILAYAS.forEach((w,i)=>{
  const o=document.createElement('option');
  o.value=i;o.textContent=w.n;sel.appendChild(o);
});

let curW=null,curDel=null;
function fmt(n){return n.toLocaleString('ar-DZ')+' دج'}

function onWilaya(){
  const idx=sel.value;
  curDel=null;
  ['d-home','d-office'].forEach(id=>document.getElementById(id).classList.remove('selected'));
  document.getElementById('f-summary').classList.remove('show');
  checkForm();
  if(idx===''){document.getElementById('delivery-wrap').style.display='none';return}
  curW=WILAYAS[idx];
  document.getElementById('dh-delay').textContent=curW.d;
  document.getElementById('dh-price').textContent=fmt(curW.h);
  document.getElementById('do-delay').textContent=curW.d;
  document.getElementById('do-price').textContent=fmt(curW.o);
  document.getElementById('delivery-wrap').style.display='block';
}

function pickDel(type){
  if(!curW)return;
  curDel=type;
  document.getElementById('d-home').classList.toggle('selected',type==='home');
  document.getElementById('d-office').classList.toggle('selected',type==='office');
  const cost=type==='home'?curW.h:curW.o;
  document.getElementById('s-del').textContent=fmt(cost);
  document.getElementById('s-total').textContent=fmt(PRICE+cost);
  document.getElementById('f-summary').classList.add('show');
  checkForm();
}

function checkForm(){
  const ok=document.getElementById('f-name').value.trim()&&
           document.getElementById('f-phone').value.trim()&&
           sel.value!==''&&curDel;
  document.getElementById('f-btn').disabled=!ok;
}

document.getElementById('f-name').addEventListener('input',checkForm);
document.getElementById('f-phone').addEventListener('input',checkForm);

function doOrder(){
  document.getElementById('form-body').style.display='none';
  document.getElementById('success-msg').classList.add('show');
}
</script>
</body>
</html>
