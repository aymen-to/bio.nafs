<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>BIO NAFAS | شاي القولون العصبي الطبيعي</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&family=Playfair+Display:ital,wght@1,700&display=swap" rel="stylesheet">
<style>
:root{
  --green:#4a9e1f;
  --green2:#65b32e;
  --green3:#2b5d12;
  --greenlight:#eef7df;
  --greenborder:#c5e89a;
  --gold:#c9a84c;
  --cream:#fafaf5;
  --text:#1a1a1a;
  --muted:#666;
  --white:#fff;
  --radius:20px;
  --shadow:0 20px 60px rgba(0,0,0,.10);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Cairo',sans-serif;background:var(--cream);color:var(--text);overflow-x:hidden}
a{text-decoration:none;color:inherit}

/* ─── SCROLLBAR ─── */
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:var(--greenlight)}
::-webkit-scrollbar-thumb{background:var(--green);border-radius:10px}

/* ─── NAV ─── */
nav{
  position:fixed;top:0;width:100%;z-index:999;
  background:rgba(255,255,255,.92);backdrop-filter:blur(12px);
  border-bottom:1px solid rgba(101,179,46,.15);
  padding:14px 6%;display:flex;align-items:center;justify-content:space-between;
}
.nav-logo{font-size:22px;font-weight:900;color:var(--green3);letter-spacing:1px}
.nav-logo span{color:var(--green)}
.nav-cta{
  background:var(--green);color:var(--white);
  padding:10px 28px;border-radius:50px;font-size:15px;font-weight:700;
  transition:.3s;border:2px solid var(--green)
}
.nav-cta:hover{background:transparent;color:var(--green)}

/* ─── HERO ─── */
.hero{
  min-height:100vh;
  background:linear-gradient(135deg,#0d2b05 0%,#1e5009 40%,#2d7a0e 70%,#1a4507 100%);
  display:flex;align-items:center;justify-content:center;
  padding:120px 6% 80px;position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse at 20% 50%,rgba(101,179,46,.18) 0%,transparent 60%),
             radial-gradient(ellipse at 80% 30%,rgba(201,168,76,.12) 0%,transparent 50%);
}
.hero-particles{position:absolute;inset:0;overflow:hidden;pointer-events:none}
.particle{
  position:absolute;width:4px;height:4px;background:rgba(101,179,46,.4);border-radius:50%;
  animation:float linear infinite;
}
@keyframes float{
  0%{transform:translateY(100vh) rotate(0);opacity:0}
  10%{opacity:1}
  90%{opacity:1}
  100%{transform:translateY(-100px) rotate(360deg);opacity:0}
}
.hero-inner{
  display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;
  max-width:1200px;width:100%;position:relative;z-index:2;
}
.hero-text{color:var(--white)}
.hero-badge{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(201,168,76,.2);border:1px solid rgba(201,168,76,.4);
  color:#f0d88a;padding:8px 20px;border-radius:50px;font-size:13px;font-weight:600;
  margin-bottom:28px;
}
.hero h1{font-size:58px;font-weight:900;line-height:1.2;margin-bottom:22px}
.hero h1 em{font-style:italic;color:#a8e063;font-family:'Playfair Display',serif}
.hero-desc{font-size:19px;line-height:1.9;color:rgba(255,255,255,.82);margin-bottom:36px}
.hero-btns{display:flex;gap:16px;flex-wrap:wrap}
.btn-primary{
  background:var(--green2);color:var(--white);
  padding:18px 42px;border-radius:50px;font-size:18px;font-weight:700;
  transition:.3s;display:inline-flex;align-items:center;gap:10px;
  box-shadow:0 8px 30px rgba(101,179,46,.4)
}
.btn-primary:hover{background:#4a9020;transform:translateY(-3px);box-shadow:0 12px 40px rgba(101,179,46,.5)}
.btn-secondary{
  background:transparent;color:var(--white);
  padding:18px 36px;border-radius:50px;font-size:16px;font-weight:600;
  border:2px solid rgba(255,255,255,.35);transition:.3s
}
.btn-secondary:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.6)}
.hero-stats{
  display:flex;gap:30px;margin-top:40px;padding-top:30px;
  border-top:1px solid rgba(255,255,255,.15)
}
.stat{text-align:center}
.stat-num{font-size:32px;font-weight:900;color:#a8e063}
.stat-label{font-size:13px;color:rgba(255,255,255,.65);margin-top:2px}

/* product visual side */
.hero-visual{display:flex;align-items:center;justify-content:center;position:relative}
.product-glow{
  position:absolute;width:350px;height:350px;
  background:radial-gradient(circle,rgba(101,179,46,.25) 0%,transparent 70%);
  border-radius:50%;animation:pulse 3s ease-in-out infinite
}
@keyframes pulse{0%,100%{transform:scale(1);opacity:.7}50%{transform:scale(1.1);opacity:1}}
.product-img-wrap{
  position:relative;z-index:2;
  background:rgba(255,255,255,.07);backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.15);border-radius:30px;
  padding:30px;width:320px;text-align:center
}
.product-img-wrap img{width:100%;border-radius:20px;display:block}
.product-img-placeholder{
  width:260px;height:260px;margin:0 auto;
  background:linear-gradient(135deg,rgba(101,179,46,.3),rgba(43,93,18,.5));
  border-radius:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;
  color:rgba(255,255,255,.7);font-size:14px;gap:12px
}
.product-img-placeholder svg{opacity:.6}
.floating-tag{
  position:absolute;background:var(--white);border-radius:14px;
  padding:10px 16px;font-size:13px;font-weight:700;
  box-shadow:0 8px 25px rgba(0,0,0,.15);
  display:flex;align-items:center;gap:8px;white-space:nowrap;color:var(--green3)
}
.tag1{top:-20px;right:-20px}
.tag2{bottom:20px;left:-30px}
.tag3{top:50%;left:-40px;transform:translateY(-50%)}

/* ─── SECTION BASE ─── */
section{padding:100px 6%}
.section-label{
  display:inline-block;background:var(--greenlight);color:var(--green3);
  padding:6px 20px;border-radius:50px;font-size:13px;font-weight:700;
  margin-bottom:18px;border:1px solid var(--greenborder)
}
.section-title{font-size:44px;font-weight:900;color:var(--green3);line-height:1.25;margin-bottom:16px}
.section-sub{font-size:18px;color:var(--muted);line-height:1.9;max-width:680px;margin:0 auto}
.section-head{text-align:center;margin-bottom:70px}

/* ─── BENEFITS ─── */
.benefits-section{background:var(--white)}
.benefits-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:28px
}
.benefit-card{
  background:var(--cream);border-radius:24px;padding:36px 28px;
  border:1.5px solid transparent;transition:.4s;position:relative;overflow:hidden
}
.benefit-card::before{
  content:'';position:absolute;inset:0;border-radius:24px;
  background:linear-gradient(135deg,var(--green2),var(--green3));
  opacity:0;transition:.4s;z-index:0
}
.benefit-card:hover{border-color:var(--green2);transform:translateY(-8px);box-shadow:var(--shadow)}
.benefit-card:hover::before{opacity:.04}
.benefit-card>*{position:relative;z-index:1}
.benefit-icon-wrap{
  width:72px;height:72px;background:var(--greenlight);border-radius:20px;
  display:flex;align-items:center;justify-content:center;margin-bottom:22px;
  font-size:34px;transition:.4s
}
.benefit-card:hover .benefit-icon-wrap{background:var(--green2);transform:scale(1.1)}
.benefit-card h3{font-size:22px;font-weight:700;color:var(--green3);margin-bottom:12px}
.benefit-card p{line-height:1.9;color:var(--muted);font-size:16px}

/* ─── INFOGRAPHIC ─── */
.infographic-section{
  background:linear-gradient(180deg,#0f3305 0%,#1a5208 50%,#0f3305 100%);
  color:var(--white);position:relative;overflow:hidden
}
.infographic-section::before{
  content:'';position:absolute;inset:0;
  background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%2365b32e' fill-opacity='0.06'%3E%3Ccircle cx='30' cy='30' r='2'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
}
.infographic-section .section-title{color:var(--white)}
.infographic-section .section-sub{color:rgba(255,255,255,.7)}
.infographic-section .section-label{background:rgba(101,179,46,.2);color:#a8e063;border-color:rgba(101,179,46,.3)}
.infographic-wrap{position:relative;z-index:2;max-width:1100px;margin:0 auto}

/* ingredients infographic */
.ingr-grid{
  display:grid;grid-template-columns:repeat(2,1fr);gap:30px;margin-top:60px
}
.ingr-card{
  background:rgba(255,255,255,.07);backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.12);border-radius:24px;
  padding:32px;display:flex;gap:22px;align-items:flex-start;
  transition:.3s
}
.ingr-card:hover{background:rgba(255,255,255,.11);transform:translateY(-4px)}
.ingr-icon{
  min-width:64px;height:64px;border-radius:18px;
  background:rgba(101,179,46,.25);border:1px solid rgba(101,179,46,.3);
  display:flex;align-items:center;justify-content:center;font-size:32px
}
.ingr-name{font-size:22px;font-weight:900;color:#a8e063;margin-bottom:8px}
.ingr-desc{font-size:15px;line-height:1.8;color:rgba(255,255,255,.72)}
.ingr-props{display:flex;flex-wrap:wrap;gap:8px;margin-top:14px}
.ingr-prop{
  background:rgba(101,179,46,.2);border:1px solid rgba(101,179,46,.3);
  color:#c8f07a;padding:4px 14px;border-radius:50px;font-size:12px;font-weight:600
}

/* molecule diagram SVG section */
.molecule-section{margin-top:80px;text-align:center}
.molecule-title{font-size:28px;font-weight:700;color:var(--white);margin-bottom:40px}

/* ─── HOW-TO ─── */
.howto-section{background:var(--white)}
.steps-flow{
  display:grid;grid-template-columns:repeat(4,1fr);gap:0;
  position:relative;margin-top:60px
}
.steps-flow::before{
  content:'';position:absolute;top:50px;right:12.5%;left:12.5%;height:2px;
  background:linear-gradient(to left,var(--green2),var(--greenborder));z-index:0
}
.step-item{
  display:flex;flex-direction:column;align-items:center;
  text-align:center;padding:0 20px;position:relative;z-index:1
}
.step-num{
  width:70px;height:70px;background:var(--white);
  border:3px solid var(--green2);border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:26px;font-weight:900;color:var(--green2);margin-bottom:22px;
  box-shadow:0 0 0 8px var(--greenlight);transition:.3s
}
.step-item:hover .step-num{background:var(--green2);color:var(--white);transform:scale(1.1)}
.step-icon{font-size:32px;margin-bottom:14px}
.step-item h3{font-size:18px;font-weight:700;color:var(--green3);margin-bottom:10px}
.step-item p{font-size:15px;color:var(--muted);line-height:1.8}

/* ─── TESTIMONIAL STRIP ─── */
.testi-section{
  background:linear-gradient(135deg,#1a5208,#2d7a0e);
  padding:80px 6%;
}
.testi-inner{max-width:900px;margin:0 auto;text-align:center;color:var(--white)}
.quote-mark{font-size:100px;line-height:.6;color:rgba(168,224,99,.3);font-family:'Playfair Display',serif;margin-bottom:20px}
.testi-text{font-size:26px;font-weight:300;line-height:2;color:rgba(255,255,255,.9);margin-bottom:30px}
.testi-author{font-size:16px;color:#a8e063;font-weight:600}

/* ─── TRUST BADGES ─── */
.trust-section{background:var(--greenlight);padding:50px 6%}
.trust-inner{
  display:flex;align-items:center;justify-content:center;flex-wrap:wrap;
  gap:40px;max-width:1000px;margin:0 auto
}
.trust-badge{
  display:flex;align-items:center;gap:14px;
  background:var(--white);padding:18px 28px;border-radius:16px;
  box-shadow:0 4px 15px rgba(0,0,0,.06);
}
.trust-badge .t-icon{font-size:32px}
.trust-badge .t-text strong{display:block;font-size:16px;font-weight:700;color:var(--green3)}
.trust-badge .t-text span{font-size:13px;color:var(--muted)}

/* ─── ORDER FORM ─── */
.order-section{background:var(--cream);padding:100px 6%}
.order-wrap{
  display:grid;grid-template-columns:1fr 1fr;gap:60px;
  max-width:1100px;margin:0 auto;align-items:start
}
.order-info{}
.order-info .section-title{text-align:right;font-size:38px}
.order-info .section-sub{text-align:right;margin:0}
.why-list{margin-top:36px}
.why-item{
  display:flex;align-items:flex-start;gap:14px;margin-bottom:22px
}
.why-check{
  min-width:36px;height:36px;background:var(--green2);border-radius:50%;
  display:flex;align-items:center;justify-content:center;color:var(--white);font-size:18px;margin-top:2px
}
.why-text strong{display:block;font-size:17px;color:var(--green3);margin-bottom:4px}
.why-text span{font-size:15px;color:var(--muted);line-height:1.7}

/* form card */
.form-card{
  background:var(--white);border-radius:28px;
  border:1.5px solid var(--greenborder);
  padding:44px 38px;
  box-shadow:0 20px 60px rgba(43,93,18,.12)
}
.form-card .form-title{font-size:26px;font-weight:900;color:var(--green3);margin-bottom:6px}
.form-card .form-sub{font-size:15px;color:var(--muted);margin-bottom:32px}
.field{margin-bottom:22px}
.field label{
  display:block;font-size:14px;font-weight:700;color:var(--text);margin-bottom:8px
}
.field input,.field select{
  width:100%;padding:15px 18px;
  border-radius:14px;border:1.5px solid #e0e0e0;
  background:var(--cream);font-family:'Cairo';font-size:16px;
  color:var(--text);transition:.25s;
}
.field input:focus,.field select:focus{
  outline:none;border-color:var(--green2);background:var(--white);
  box-shadow:0 0 0 4px rgba(101,179,46,.12)
}
.delivery-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:8px}
.d-opt{
  border:2px solid #e0e0e0;border-radius:16px;padding:18px 14px;
  text-align:center;cursor:pointer;transition:.25s;background:var(--cream)
}
.d-opt.selected{border-color:var(--green2);background:var(--greenlight)}
.d-opt .d-icon{font-size:26px;margin-bottom:6px}
.d-opt .d-title{font-size:15px;font-weight:700;color:var(--text)}
.d-opt .d-delay{font-size:12px;color:var(--muted);margin:3px 0}
.d-opt .d-price{font-size:20px;font-weight:900;color:var(--green)}
.summary-box{
  background:var(--greenlight);border:1.5px solid var(--greenborder);border-radius:18px;
  padding:20px 24px;margin:24px 0;display:none
}
.summary-box.show{display:block}
.sum-row{
  display:flex;justify-content:space-between;align-items:center;
  font-size:15px;color:var(--muted);padding:5px 0
}
.sum-row.total{
  font-size:22px;font-weight:900;color:var(--green3);
  border-top:1.5px solid var(--greenborder);margin-top:10px;padding-top:14px
}
.submit-btn{
  width:100%;padding:20px;background:var(--green2);border:none;
  color:var(--white);font-family:'Cairo';font-size:20px;font-weight:900;
  border-radius:18px;cursor:pointer;transition:.3s;
  box-shadow:0 8px 25px rgba(101,179,46,.35)
}
.submit-btn:hover{background:var(--green3);transform:translateY(-2px);box-shadow:0 12px 35px rgba(43,93,18,.4)}
.submit-btn:disabled{background:#bbb;box-shadow:none;transform:none;cursor:not-allowed}
.form-note{text-align:center;font-size:13px;color:var(--muted);margin-top:14px}
.success-msg{display:none;text-align:center;padding:20px 0}
.success-msg.show{display:block}
.success-msg .s-icon{font-size:64px;margin-bottom:16px}
.success-msg h3{font-size:24px;font-weight:900;color:var(--green3);margin-bottom:10px}
.success-msg p{color:var(--muted);line-height:1.9;font-size:16px}

/* ─── FOOTER ─── */
footer{
  background:#0d2b05;color:rgba(255,255,255,.7);
  text-align:center;padding:40px 6%;font-size:15px;line-height:2
}
footer strong{color:#a8e063}

/* ─── ANIMATIONS ─── */
.reveal{opacity:0;transform:translateY(40px);transition:opacity .7s ease,transform .7s ease}
.reveal.visible{opacity:1;transform:none}
.reveal-left{opacity:0;transform:translateX(40px);transition:opacity .7s ease,transform .7s ease}
.reveal-left.visible{opacity:1;transform:none}
.reveal-right{opacity:0;transform:translateX(-40px);transition:opacity .7s ease,transform .7s ease}
.reveal-right.visible{opacity:1;transform:none}

/* ─── RESPONSIVE ─── */
@media(max-width:900px){
  .hero-inner{grid-template-columns:1fr;text-align:center}
  .hero-visual{display:none}
  .hero h1{font-size:38px}
  .hero-btns{justify-content:center}
  .hero-stats{justify-content:center}
  .steps-flow{grid-template-columns:repeat(2,1fr);gap:30px}
  .steps-flow::before{display:none}
  .ingr-grid{grid-template-columns:1fr}
  .order-wrap{grid-template-columns:1fr}
  .order-info .section-title,.order-info .section-sub{text-align:center}
  .why-item{flex-direction:row}
  .section-title{font-size:32px}
  nav{padding:12px 4%}
}
@media(max-width:600px){
  .benefits-grid{grid-template-columns:1fr}
  .delivery-grid{grid-template-columns:1fr}
  .hero h1{font-size:30px}
  .form-card{padding:28px 20px}
  section{padding:70px 5%}
}
</style>
</head>
<body>

<!-- ═══ NAV ═══ -->
<nav>
  <div class="nav-logo">BIO <span>NAFAS</span></div>
  <a href="#order" class="nav-cta">اطلب الآن ←</a>
</nav>

<!-- ═══ HERO ═══ -->
<section class="hero" id="hero">
  <div class="hero-particles" id="particles"></div>
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-badge">
        <span>🌿</span>
        <span>100٪ طبيعي · مجرّب · آمن</span>
      </div>
      <h1>راحة حقيقية<br>من القولون <em>العصبي</em></h1>
      <p class="hero-desc">
        خلطة عشبية مدروسة تجمع بين أقوى الأعشاب المهدئة للجهاز الهضمي —
        تخفف التشنجات، تقضي على الانتفاخ، وتعيد لك هدوءك اليومي.
      </p>
      <div class="hero-btns">
        <a href="#order" class="btn-primary">اطلب الآن ← </a>
        <a href="#ingredients" class="btn-secondary">اكتشف المكونات</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><div class="stat-num">4</div><div class="stat-label">مكونات طبيعية</div></div>
        <div class="stat"><div class="stat-num">J+1</div><div class="stat-label">توصيل سريع</div></div>
        <div class="stat"><div class="stat-num">✓</div><div class="stat-label">بدون آثار جانبية</div></div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="product-glow"></div>
      <div class="product-img-wrap">
        <img src="BIO-nafas-x.jpg" alt="BIO NAFAS" onerror="this.style.display='none';document.getElementById('ph').style.display='flex'">
        <div class="product-img-placeholder" id="ph" style="display:none">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M32 8C32 8 20 20 20 34C20 41 25.4 47 32 47C38.6 47 44 41 44 34C44 20 32 8 32 8Z" fill="rgba(101,179,46,.6)"/>
            <path d="M32 20C32 20 24 28 24 36C24 40.4 27.6 44 32 44" stroke="rgba(255,255,255,.5)" stroke-width="2" fill="none"/>
          </svg>
          <span>BIO NAFAS</span>
          <span style="font-size:11px;opacity:.6">ضع صورة المنتج هنا</span>
        </div>
        <div class="floating-tag tag1">🌿 عشبي 100٪</div>
        <div class="floating-tag tag2">🚚 توصيل للجزائر كلها</div>
        <div class="floating-tag tag3">⭐ فعّال وآمن</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ TRUST ═══ -->
<div class="trust-section">
  <div class="trust-inner">
    <div class="trust-badge"><span class="t-icon">🌱</span><div class="t-text"><strong>100٪ طبيعي</strong><span>بدون مواد اصطناعية</span></div></div>
    <div class="trust-badge"><span class="t-icon">🔬</span><div class="t-text"><strong>مكونات مدروسة</strong><span>خلطة متوازنة بعناية</span></div></div>
    <div class="trust-badge"><span class="t-icon">🚚</span><div class="t-text"><strong>توصيل لكل الولايات</strong><span>28 ولاية مغطاة</span></div></div>
